# TradeWatch Production Environment Template
#
# Copy to `.env` on the production Application Server and fill in every value.
# Keys marked "# SENSITIVE — do not commit a value" must never be filled in
# within this example file or any committed file — only in the real, uncommitted
# `.env` on the target server (or your secrets manager, if the eventual hosting
# decision, TDD-ADR-005, provides one).
#
# See docs/deployment-checklist.md Section 3 for how this file is used during
# deployment.

APP_NAME=TradeWatch
APP_ENV=production
# SENSITIVE — do not commit a value
APP_KEY=
APP_DEBUG=false
APP_URL=https://tradewatch.go.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=tradewatch
DB_USERNAME=tradewatch_app
# SENSITIVE — do not commit a value
DB_PASSWORD=

# NFR-SEC-004: production security defaults. Do not weaken any of these for
# production; SESSION_SECURE_COOKIE=true requires TLS to actually be
# terminated in front of the app (docs/deployment-checklist.md Section 8) or
# login will silently break.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null

# Real production frontend domain(s) only — never localhost.
SANCTUM_STATEFUL_DOMAINS=tradewatch.go.ke
CORS_ALLOWED_ORIGINS=https://tradewatch.go.ke
FRONTEND_URL=https://tradewatch.go.ke

# NFR-SEC-004: POST /login rate limit, keyed per-IP. Keep at the secure
# default (5) in production. Only raise this in a non-production environment
# when running the Playwright/k6 suites, which log in as many fixture
# accounts from one host (Session 39/40 precedent) — never raise it here.
LOGIN_THROTTLE_PER_MINUTE=5

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# TDD-ADR-013: upload storage volume, mounted separately from the app
# codebase, sized for 2TB in Production (docs/deployment-checklist.md
# Section 1). Must point at the mounted volume, not local application disk.
STORAGE_PATH=
UPLOADS_DISK_PATH=${STORAGE_PATH}

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
# SENSITIVE — do not commit a value
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="tradewatch@icta.go.ke"
MAIL_FROM_NAME="TradeWatch — ICTA"

VITE_APP_NAME="${APP_NAME}"
