APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tradewatch
DB_USERNAME=tradewatch
DB_PASSWORD=tradewatch_dev

SESSION_DRIVER=database
# NFR-SEC-004: production/audit defaults. SESSION_SECURE_COOKIE requires the
# app to actually be served over HTTPS — set it to false only for local HTTP
# development (see .env's own override and its comment).
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:5173,tradewatch.go.ke
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tradewatch.go.ke
FRONTEND_URL=http://localhost:5173

# NFR-SEC-004: POST /login rate limit, keyed per-IP. Keep at the secure default in
# production; raise only in a local, uncommitted .env if running the Playwright E2E
# suite, which logs in as many fixture accounts from one host (see .env's own
# override and its comment).
LOGIN_THROTTLE_PER_MINUTE=5

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="tradewatch@icta.go.ke"
MAIL_FROM_NAME="TradeWatch — ICTA"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
